{
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "name": "Papel", "slug": "base", "color": "#f6f1e7" },
				{ "name": "Tinta", "slug": "contrast", "color": "#1b2433" },
				{ "name": "Azul", "slug": "accent-1", "color": "#2f4b7c" },
				{ "name": "Papel tostado", "slug": "accent-2", "color": "#ebe3d3" },
				{ "name": "Mostaza", "slug": "accent-3", "color": "#a8741a" },
				{ "name": "Gris pizarra", "slug": "accent-4", "color": "#5f6773" },
				{ "name": "Blanco roto", "slug": "accent-5", "color": "#fffcf5" },
				{ "name": "Verde botella", "slug": "accent-6", "color": "#2e4a3f" }
			]
		},
		"layout": { "contentSize": "760px", "wideSize": "1240px" },
		"typography": {
			"fontFamilies": [
				{
					"name": "DM Sans",
					"slug": "dm-sans",
					"fontFamily": "\"DM Sans\", system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "DM Sans", "fontStyle": "normal", "fontWeight": "300 800", "fontDisplay": "swap", "src": [ "file:./assets/fonts/dm-sans.woff2" ] }
					]
				},
				{
					"name": "Newsreader",
					"slug": "newsreader",
					"fontFamily": "Newsreader, Georgia, serif",
					"fontFace": [
						{ "fontFamily": "Newsreader", "fontStyle": "normal", "fontWeight": "300 800", "fontDisplay": "swap", "src": [ "file:./assets/fonts/newsreader.woff2" ] },
						{ "fontFamily": "Newsreader", "fontStyle": "italic", "fontWeight": "300 800", "fontDisplay": "swap", "src": [ "file:./assets/fonts/newsreader-italic.woff2" ] }
					]
				}
			]
		}
	},
	"styles": {
		"color": { "background": "var:preset|color|base", "text": "var:preset|color|contrast" },
		"typography": { "fontFamily": "var:preset|font-family|dm-sans", "fontSize": "17px", "lineHeight": "1.6", "fontWeight": "400" },
		"elements": {
			"heading": {
				"typography": { "fontFamily": "var:preset|font-family|newsreader", "fontWeight": "500", "letterSpacing": "-0.02em", "lineHeight": "1.08" },
				"color": { "text": "var:preset|color|contrast" }
			},
			"link": {
				"color": { "text": "var:preset|color|contrast" },
				":hover": { "color": { "text": "var:preset|color|accent-1" } }
			},
			"button": {
				"color": { "background": "var:preset|color|contrast", "text": "var:preset|color|accent-5" },
				"border": { "radius": "999px" },
				"typography": { "fontFamily": "var:preset|font-family|dm-sans", "fontWeight": "700", "fontSize": "15px" },
				"spacing": { "padding": { "top": "14px", "bottom": "14px", "left": "26px", "right": "26px" } },
				":hover": { "color": { "background": "var:preset|color|accent-1", "text": "var:preset|color|accent-5" } }
			}
		}
	}
}
